{% comment %}
  PRODUCTS GUIDE GRID SECTION

  Purpose: Display 6 products in a grid with clickable hotspots that open popup
  Features:
  - 6 product blocks selectable from customizer
  - Circular "+" hotspots on each product image
  - Responsive: 3 columns (desktop) / 1 column (mobile)
  - Triggers popup on hotspot click
  - Hides blocks with no product selected

  Author: Candidate Assignment
  Date: 2026-01-03
{% endcomment %}

<div class="products-guide-section" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="products-guide-heading">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

  <div class="products-guide-grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}

      {%- comment -%}
        WHY: Only render blocks with products selected
        Keeps the grid clean and prevents empty spaces
      {%- endcomment -%}
      {%- if product != blank -%}
        <div class="products-guide-item" {{ block.shopify_attributes }}>
          <div class="products-guide-card">
            {%- comment -%} Product Image {%- endcomment -%}
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="products-guide-image"
                loading="lazy"
                width="800"
                height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
              >
            {%- else -%}
              {%- comment -%} Fallback if no image {%- endcomment -%}
              {{ 'product-1' | placeholder_svg_tag: 'products-guide-placeholder' }}
            {%- endif -%}

            {%- comment -%}
              Hotspot Button - Opens popup with product details
              WHY: data-product-handle is used instead of ID for cleaner AJAX fetch
            {%- endcomment -%}
            <button
              class="products-guide-hotspot"
              data-product-handle="{{ product.handle }}"
              data-product-id="{{ product.id }}"
              aria-label="View {{ product.title }} details"
              type="button"
            >
              <span class="hotspot-icon">+</span>
            </button>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- comment -%}
  Small inline script for hotspot click handling
  WHY: Keeps event listeners close to markup for clarity
  Actual popup logic is in separate product-popup.js file
{%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hotspots = document.querySelectorAll('.products-guide-hotspot');

    hotspots.forEach(function (hotspot) {
      hotspot.addEventListener('click', function (e) {
        e.preventDefault();

        const productHandle = this.getAttribute('data-product-handle');

        // Call popup function from product-popup.js
        if (typeof window.openProductPopup === 'function') {
          window.openProductPopup(productHandle);
        } else {
          showNotification('Product popup script not loaded', 'error');
        }
      });
    });
  });
</script>

{{ 'products-guide.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Products Guide Grid",
  "tag": "section",
  "class": "section-products-guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products Guide Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
